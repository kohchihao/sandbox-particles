{
  "name": "falling-sand",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sim.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/sim.test.ts",
    "test:scenario": "vitest run tests/scenario.test.ts",
    "test:invariants": "vitest run tests/invariants.test.ts",
    "test:golden": "vitest run tests/golden.test.ts",
    "test:golden:accept": "UPDATE_GOLDENS=1 vitest run tests/golden.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "bench": "vite-node --mode production scripts/bench.ts",
    "bench:accept": "UPDATE_BASELINE=1 vite-node --mode production scripts/bench.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.4"
  }
}
